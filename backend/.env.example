# =============================================================================
# Colombo Cargo Connect — Backend (Laravel 11) environment
# =============================================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env. NEVER share APP_KEY or any *_SECRET values.
# Generate APP_KEY with: php artisan key:generate

# --- Application ---
APP_NAME="Colombo Cargo Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost:8000

# --- Logging ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (PostgreSQL 16 + PostGIS) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ccc
DB_USERNAME=ccc
DB_PASSWORD=ccc_local_dev_only

# --- Cache, session, queue (all backed by Redis) ---
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3001
SESSION_DOMAIN=localhost

# --- Filesystems / Supabase Storage ---
# Supabase Storage is S3-compatible. Get URL + service role key from
# https://supabase.com/dashboard/project/_/settings/api
FILESYSTEM_DISK=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET_LABELS=ccc-labels
SUPABASE_BUCKET_PROOFS=ccc-proofs

# --- WhatsApp Cloud API (Meta) ---
# Get from https://developers.facebook.com/apps/<app-id>/whatsapp-business/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- SMS / OTP (Notify.lk) ---
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=NotifyDEMO

# --- Push notifications (Firebase Cloud Messaging) ---
# Path to Firebase service account JSON (do NOT commit the file)
FCM_CREDENTIALS_PATH=storage/app/firebase/service-account.json
FCM_PROJECT_ID=

# --- Payments (deferred to v1.1 — placeholder only) ---
WEBXPAY_MERCHANT_ID=
WEBXPAY_SECRET_KEY=
WEBXPAY_RETURN_URL=

# --- QR / JWT signing ---
# Separate key from APP_KEY so QR tokens can be rotated independently
QR_TOKEN_SECRET=
QR_TOKEN_TTL_DAYS=30

# --- Observability ---
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Mail (transactional email — fallback channel) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@cargo.lk
MAIL_FROM_NAME="${APP_NAME}"

# --- CORS (sender + tracking + admin web origins) ---
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
